# Optional LLM agent harness configuration.
# Leave keys empty to use the deterministic offline fallback.
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=45

# Google Gemini / Gen AI SDK.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Compatibility with OpenAI-style environments.
OPENAI_API_KEY=
OPENAI_MODEL=
